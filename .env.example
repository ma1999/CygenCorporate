# Copy the variables you need into .env (never commit real values).
# The existing variables (DB_*, SECRET_KEY, TEMPLATES_DIR, ASSETS_DIR, ASSETS_DIR_Max_Size, CACHE_TTL) are unchanged.

# ---- headless frontend / public API (/api/public/*) -------------------------
# Origin used for absolute media/download URLs. Empty = taken from the request
# (X-Forwarded-Proto / X-Forwarded-Host are honoured).
PUBLIC_BASE_URL=
# Comma separated frontend origins allowed to call /api/public from a browser.
# Empty = no CORS headers at all.   e.g. https://aryasanat-corp.ir,http://localhost:3000
CORS_ALLOWED_ORIGINS=
# In-process response cache for /api/public GETs (seconds, 0 = off). It is cleared on every
# content write, but only inside the worker that handled the write: with several workers use 0.
PUBLIC_API_CACHE_TTL=30
# Seconds a request waits for a free DB pool connection before answering 503 (DB_POOL_SIZE tunes the pool).
DB_POOL_WAIT=10

# ---- frontend revalidation webhook (both required, otherwise disabled) --------
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=
# Page builder preview: origin of the frontend shown in the editor iframe (default: origin of FRONTEND_REVALIDATE_URL)
FRONTEND_PREVIEW_URL=

# ---- downloadable documents ---------------------------------------------------
DOCUMENT_ALLOWED_EXTENSIONS=pdf,zip,step,stp,igs,iges,dwg,dxf,doc,docx,xls,xlsx,ppt,pptx,csv,txt,png,jpg,jpeg,webp
DOCUMENT_MAX_SIZE_MB=50
DOCUMENT_STORAGE_DIR=storage/documents

# ---- CAPTCHA for the contact form (optional) -----------------------------------
# When provider + secret are set, POST /api/public/inquiries requires "captcha_token" and the widget's
# public key is exposed by GET /api/public/site (site.captcha). Provider: turnstile | hcaptcha
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=

# ---- draft preview / page-view tracking ------------------------------------------
# Lifetime (seconds) of the signed ?preview= token the admin panel hands to the frontend
PREVIEW_TOKEN_TTL=3600
# Days of POST /api/public/track data kept (tracking itself is switched on in /admin/site-settings)
TRACK_RETENTION_DAYS=180

# ---- contact form (POST /api/public/inquiries) --------------------------------
INQUIRY_RATE_PER_HOUR=5
INQUIRY_RATE_PER_DAY=20
# Email notification (optional). Recipients are set in /admin/site-settings (tab "استعلام").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# ---- misc ---------------------------------------------------------------------
# Shown by GET /api/public/health (default: git short sha, else "dev")
APP_VERSION=
